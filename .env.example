# AI SalesFlow Environment Variables
# Copy this to .env and fill in your values

# Server
PORT=3000
NODE_ENV=development

# JWT Secret (generate a strong random string for production)
JWT_SECRET=change-this-to-a-strong-random-secret-key

# Database
DATABASE_PATH=./data/salesflow.db

# AI Configuration (Demo mode when not set)
OPENAI_API_KEY=

# WhatsApp Business API
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=

# Telegram Bot
TELEGRAM_BOT_TOKEN=

# Google Sheets
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Stripe Payments
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET/
